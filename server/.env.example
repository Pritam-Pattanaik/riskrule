# Copy to server/.env and fill in real values. NEVER commit server/.env.
# Placeholders below are intentionally not valid secrets.

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PORT=3000

# --- Auth secrets (REQUIRED in production; the server refuses to start without them) ---
# Generate EACH with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rules: >= 32 chars, random, and JWT_SECRET must differ from CSRF_SECRET.
# Use different values for production, preview and local development.
JWT_SECRET=
CSRF_SECRET=

# --- Razorpay (payments return 503 / webhooks are rejected if these are missing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional ---
EXTERNAL_FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
